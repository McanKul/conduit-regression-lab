{
  "_comment": "Tuned for ASP.NET Core. CI generates base/revision Roslyn indexes; regex source analysis is disabled. Anything matching global_triggers sets the global flag.",
  "exclude_globs": [
    "**/obj/**",
    "**/bin/**",
    "**/*.Designer.cs",
    "**/*Tests/**",
    "**/*.Tests/**",
    "tools/DotnetApiRegression.Analyzer/**"
  ],
  "exclude_dir_names": [".git", ".idea", ".vs", ".vscode", "bin", "obj", "node_modules"],
  "controller_suffix": "Controller",
  "minimal_api_map_regex": "Map(?:Get|Post|Put|Delete|Patch|Methods)\\s*(?:<[^>]*>)?\\(\\s*\"([^\"]+)\"",
  "path_match_case_insensitive": true,
  "source_analysis_mode": "semantic",
  "semantic_max_hops": 32,
  "semantic_unresolved_strategy": "all",
  "global_impact_strategy": "all",
  "fallback_all_when_unresolved": true,
  "implements_regex": "(?:class|record|struct)\\s+\\w+\\s*(?:<[^>]*>)?\\s*(?:\\([^)]*\\))?\\s*:\\s*([^\\{\\n]+)",
  "migration_dir_regex": "(^|/)Migrations/",
  "migration_table_regex": "(?:name|table)\\s*:\\s*\"([^\"]+)\"",
  "reference_max_hops": 2,
  "min_type_name_len": 4,
  "type_name_stoplist": ["Program", "Startup", "Options", "Settings", "Constants", "Extensions", "Result", "Response"],
  "global_triggers": [
    "(^|/)Program\\.cs$",
    "(^|/)Startup\\.cs$",
    "DbContext\\.cs$",
    "(^|/)Directory\\.(Build|Packages)\\.props$",
    "\\.csproj$",
    "(^|/)Middlewares?/",
    "Auth\\w*Handler\\.cs$",
    "Base\\w*Controller\\.cs$"
  ]
}
